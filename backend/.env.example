DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# REDIS_URL=redis://localhost:6379/0
NUM_PROXIES=0
# Trust CF-Connecting-IP / True-Client-IP only behind Cloudflare (true on Render)
TRUST_CDN_IP_HEADERS=false
# Contact URL sent in the User-Agent to OSRM, Photon and Nominatim
